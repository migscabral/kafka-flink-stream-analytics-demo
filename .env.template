# Read automatically by docker-compose; do not commit real credentials.

# AWS region of the Glue catalog and the S3 warehouse bucket
AWS_REGION=us-east-1

# S3 bucket holding the Iceberg warehouse (name only, no s3:// prefix); must be in AWS_REGION
S3_BUCKET=

# Credentials for an identity with Glue and S3 access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
